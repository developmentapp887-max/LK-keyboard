<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.lk.keyboard.MainActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/subtype_english" />

    <subtype
        android:imeSubtypeLocale="ur_PK"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false"
        android:label="@string/subtype_urdu" />

    <subtype
        android:imeSubtypeLocale="ps_AF"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false"
        android:label="@string/subtype_pashto" />

    <subtype
        android:imeSubtypeLocale="en_PK"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/subtype_roman_urdu" />
</input-method>
